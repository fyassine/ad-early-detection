# Every script under DATA/ is tracked, regardless of subdirectory — only the
# data/artifacts beside them (csv, npz, nii.gz, ...) stay ignored below.
!DATA/**/*.py

# Ignore all subject data directories (recursive)
**/sub-*/

# Ignore pipeline output, staging, caching and raw data directories under DATA
DATA/**/mriqc_out/
DATA/**/fmriprep_out/
DATA/**/staging/
DATA/**/BIDS/
DATA/**/original/
DATA/**/SAMPLE/
DATA/**/.cache/
DATA/**/logs/
DATA/**/env/

# Re-ignore heavy data/binary/log files in unignored DATA subfolders
DATA/**/*.csv
DATA/**/*.xlsx
DATA/**/*.xls
DATA/**/*.pkl
DATA/**/*.npz
DATA/**/*.nii.gz
DATA/**/*.nii
DATA/**/*.mat
DATA/**/*.pth
DATA/**/*.log
DATA/**/*.sif
DATA/**/__pycache__/
DATA/**/*.py[cod]

# Downloaded IDA/LONI archives and their in-progress .download staging dirs
# (multi-GB, re-downloadable) — they land inside otherwise-tracked __artifacts__/
DATA/**/*.zip
DATA/**/*.zip.download/

