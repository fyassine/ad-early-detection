# ADNI Downloader — Credential Template
#
# Copy this file to .env and fill in your LONI IDA credentials.
# The .env file is gitignored and will never be committed.
#
# Usage:
#   cp .env.example .env
#   nano .env   (or your preferred editor)
#
# Required:
ADNI_USERNAME=your_loni_username_here
ADNI_PASSWORD=your_loni_password_here
#
# Optional — leave blank to use defaults:
# ADNI_DOWNLOAD_DELAY=2.0     # seconds between downloads (default: 2.0)
# ADNI_HEADLESS=true          # run browser headlessly (default: true)
